// Maxey Construction — Operations Platform
// Core data model per Spec.md Section 7. Phase 1 modules use a subset;
// later-phase models are defined now so migrations stay additive.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (port 6543) — used by the app
  directUrl = env("DIRECT_URL") // direct connection (port 5432) — used for migrations only
}

// ---------- Enums ----------

enum Role {
  OWNER
  PM
  FOREMAN
  PURCHASING
  ACCOUNTING
  DRIVER
  CLIENT
  OFFICE
}

enum Department {
  OFFICE
  SITE
  DRIVER
  ARCHITECT
  ENGINEER
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  REFERRAL
  WALK_IN
  GOVERNMENT_BID
  OTHER
}

enum LeadStatus {
  NEW
  UNDER_REVIEW
  ESTIMATE_IN_PROGRESS
  QUOTATION_SENT
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum QuotationItemCategory {
  MATERIAL
  LABOR
  EQUIPMENT
  OTHER
}

// Construction lifecycle per the owner's workflow. TURNED_OVER projects move
// to the "Completed/Turn-over" section; SITE_SURVEY and NOT_ACTIVE are
// prospective; the rest count as on-going.
enum ProjectStatus {
  SITE_SURVEY
  MOBILIZATION
  ONGOING_CONSTRUCTION
  NOT_ACTIVE
  ON_HOLD
  FOR_PUNCHLIST
  TURNED_OVER
}

enum PaymentTermType {
  DOWNPAYMENT
  PARTIAL
  RETENTION
  FINAL
}

enum PaymentTermStatus {
  PENDING
  DUE
  PAID
}

enum RequisitionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PO_ISSUED
  DELIVERED
}

enum Urgency {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

// Only set when a requisition has no project (Requisition.projectId is null).
enum RequisitionCategory {
  EMERGENCY
  OFFICE_SUPPLY
  WAREHOUSE_SUPPLY
}

enum POStatus {
  OPEN
  PARTIALLY_DELIVERED
  DELIVERED
  CANCELLED
}

enum ChangeOrderStatus {
  POTENTIAL // identified internally, not yet priced/sent — never visible to the client, never in contract value
  PENDING_CLIENT // sent to the client for approval
  APPROVED
  REJECTED
  WITHDRAWN // pulled back by the team before the client decided
}

enum MovementType {
  SITE_TO_WAREHOUSE
  WAREHOUSE_TO_SITE
  SITE_TO_SITE
  CONSUMED_ON_SITE // material used up in construction — decrements on-site balance only
  SUPPLIER_TO_SITE
  SUPPLIER_TO_WAREHOUSE
}

enum InstructionStatus {
  NOT_STARTED
  IN_PROGRESS
  ON_HOLD
  FOR_REVIEW
  COMPLETED
  CANCELLED
}

enum InstructionCategory {
  OFFICE
  SITE
  DELIVERIES
  WAREHOUSE
  OTHER
}

enum InstructionPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum InstructionApproval {
  PENDING
  APPROVED
  NEEDS_REVISION
}

enum PayrollStatus {
  DRAFT
  REVIEW
  APPROVED
  PAID
}

// Review lifecycle for field-reported progress: SUBMITTED (awaiting PM/Owner)
// → APPROVED, or QUERIED (sent back with a note; the submitter's edit
// resubmits it). Only APPROVED entries count toward the verified progress
// shown to owners and clients.
enum ProgressReviewStatus {
  SUBMITTED
  QUERIED
  APPROVED
}

// A client's request for additional work. It is NOT a priced change order and
// never touches the contract value: staff assess it, then either convert it
// into a normal PENDING_CLIENT change order (the existing approval flow takes
// over from there) or decline it with a reason.
// Quality & safety findings. Counts only — no rates are reported because hours worked
// aren't captured. INCIDENT findings are restricted to Owner, PM, the person who raised
// them and the assigned owner.
enum FindingType {
  DEFECT
  PUNCH_ITEM
  INSPECTION
  SAFETY_OBSERVATION
  INCIDENT
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// OPEN -> IN_PROGRESS -> READY_FOR_REVIEW (closure evidence submitted) -> CLOSED by a reviewer.
enum FindingStatus {
  OPEN
  IN_PROGRESS
  READY_FOR_REVIEW
  CLOSED
}

enum DocumentCategory {
  DRAWING
  SPECIFICATION
  PERMIT
  CONTRACT
  REPORT
  OTHER
}

enum WorkRequestStatus {
  REQUESTED
  UNDER_REVIEW
  CONVERTED
  DECLINED
  WITHDRAWN
}

enum WorkRequestKind {
  ADDITION // new work added to the contract
  CHANGE // a change to work already in the contract (may cost more or less)
  REDUCTION // scope taken out — priced as a credit back to the client
}

enum WorkRequestSource {
  PORTAL // the client sent it themselves
  PHONE
  MESSAGE // text / chat
  EMAIL
  MEETING
  SITE // said on site
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

// RFI lifecycle: OPEN -> ANSWERED -> CLOSED (or CANCELLED while still open).
enum RfiStatus {
  OPEN
  ANSWERED
  CLOSED
  CANCELLED
}

enum RfiAddressee {
  INTERNAL // answered by Maxey staff
  CLIENT // answered by the client in their portal
}

// Potential cost/schedule effect of an RFI. UNKNOWN is the honest default —
// "no data" is never treated as "no impact".
enum ImpactStatus {
  UNKNOWN
  NONE_IDENTIFIED
  POSSIBLE
  ASSESSED
}

enum PermitStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
}

// ---------- Core ----------

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  phone               String?
  passwordHash        String
  role                Role
  department          Department?
  position            String? // trade/position: Foreman, Mason, Carpenter, Welder, Driver, Office Admin…
  employeeNo          String?            @unique // company employee ID printed on the payslip, e.g. VCDC-016
  canRequisition      Boolean            @default(false) // the Owner lets this person raise material requisitions even though their role doesn't already allow it
  canApprovePettyCash Boolean            @default(false) // the Owner lets this person approve petty cash requests (the Owner always can)
  canReleasePettyCash Boolean            @default(false) // ...and/or confirm handing out approved petty cash
  canManageCash       Boolean            @default(false) // full Cash Expense access, like Accounting: every request, the fund, verification, cash advances
  payslipBaselines    PayslipBaseline[]
  pushSubscriptions   PushSubscription[]
  appNotifications    AppNotification[]
  notificationPref    NotificationPref?
  userPref            UserPref?
  passkeys            Passkey[]
  dailyRate           Decimal?           @db.Decimal(12, 2)
  hourlyRate          Decimal?           @db.Decimal(12, 2)
  // Office/Architect/Engineer paid a fixed monthly salary instead of an
  // hourly/daily rate — when set, this takes priority over both for
  // semi-monthly payroll (see computePayroll in src/lib/payroll.ts): the
  // effective daily rate for a given month is monthlySalary divided by that
  // month's count of Monday–Saturday calendar days, then /8 for an hourly
  // rate so the existing hours-based engine can price partial days.
  monthlySalary       Decimal?           @db.Decimal(12, 2)
  active              Boolean            @default(true)
  mustChangePassword  Boolean            @default(false) // temp password issued — force change on first login
  useCustomMenus      Boolean            @default(false) // true = customMenus is authoritative, ignore role's default tabs
  customMenus         String[]           @default([]) // Owner's per-account tab checklist override, when useCustomMenus
  currentSessionId    String? // single-device login (every role but OWNER): each
  // login overwrites this, so a session from an older device fails its next
  // check in getSessionUser() and is treated as signed out
  clientId            String? // portal accounts link to a Client
  client              Client?            @relation(fields: [clientId], references: [id])
  createdAt           DateTime           @default(now())

  requisitionsSubmitted    Requisition[]             @relation("ReqSubmitter")
  requisitionsApproved     Requisition[]             @relation("ReqApprover")
  itemQuotesSubmitted      ItemQuote[]
  purchaseOrders           PurchaseOrder[]
  paymentsRecorded         Payment[]
  progressEntries          ProgressEntry[]
  dailyReportsSubmitted    DailyConstructionReport[]
  instructionsPosted       SiteInstruction[]         @relation("InstructionPostedBy")
  instructionsAssigned     SiteInstruction[]         @relation("InstructionAssignedTo") // legacy single-assignee, superseded by assignedInstructions below
  assignedInstructions     SiteInstruction[]         @relation("InstructionAssignees")
  instructionsSeen         InstructionSeen[]
  changeOrdersCreated      ChangeOrder[]             @relation("COCreator")
  changeOrdersResponded    ChangeOrder[]             @relation("COResponder")
  quotationsCreated        Quotation[]
  attendance               Attendance[]
  tripLogs                 TripLog[]
  auditLogs                AuditLog[]
  assignments              ProjectAssignment[]
  resetTokens              PasswordResetToken[]
  cashSnapshots            CashSnapshot[]
  timeAdjustmentsOwned     TimeAdjustmentRequest[]   @relation("TimeAdjUser")
  timeAdjustmentsRequested TimeAdjustmentRequest[]   @relation("TimeAdjRequester")
  timeAdjustmentsDecided   TimeAdjustmentRequest[]   @relation("TimeAdjDecider")
  hoursOverridesOwned      DailyHoursOverride[]      @relation("HoursOverrideOwner")
  hoursOverridesSet        DailyHoursOverride[]      @relation("HoursOverrideSetBy")
  milestonesResponsible    Milestone[]               @relation("MilestoneResponsible")
  rfisAssigned             Rfi[]                     @relation("RfiAssignee")
  rfisRaised               Rfi[]                     @relation("RfiRaiser")
  workRequests             WorkRequest[]             @relation("WorkRequester")
  findingsRaised           Finding[]                 @relation("FindingRaiser")
  findingsOwned            Finding[]                 @relation("FindingOwner")
  pettyCashRequests        PettyCashRequest[]        @relation("PettyCashRequester")
  cashAdvances             CashAdvance[]             @relation("CashAdvanceBorrower")
}

// Self-service "forgot password" (Spec §8-adjacent hardening). Only the
// hash is stored — the raw token exists only in the emailed/texted link and
// is never persisted. Single-use: usedAt is set on redemption and the token
// is rejected afterward even if not yet expired.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Client {
  id          String     @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  source      LeadSource @default(OTHER)
  createdAt   DateTime   @default(now())

  users    User[]
  leads    Lead[]
  projects Project[]
}

model Lead {
  id            String     @id @default(cuid())
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id])
  contactName   String
  email         String?
  phone         String?
  address       String?
  source        LeadSource @default(WEBSITE)
  message       String?
  planFileUrl   String?
  attachments   Json? // client-submitted files: photos, PDFs, CAD plans ({ url, name }[])
  status        LeadStatus @default(NEW)
  estimateDueBy DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  quotations Quotation[]
  projects   Project[]
}

model Quotation {
  id          String          @id @default(cuid())
  number      String          @unique
  leadId      String
  lead        Lead            @relation(fields: [leadId], references: [id])
  markupPct   Decimal         @default(0) @db.Decimal(5, 2)
  vatPct      Decimal         @default(12) @db.Decimal(5, 2)
  notes       String?
  status      QuotationStatus @default(DRAFT)
  validUntil  DateTime?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  lineItems QuotationLineItem[]
}

model QuotationLineItem {
  id          String                @id @default(cuid())
  quotationId String
  quotation   Quotation             @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  category    QuotationItemCategory @default(MATERIAL)
  description String
  qty         Decimal               @db.Decimal(12, 2)
  unit        String
  unitPrice   Decimal               @db.Decimal(12, 2)
  sortOrder   Int                   @default(0)
}

model Project {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id])
  name            String
  code            String?       @unique // short project code, e.g. "CTC" — prefixes this project's site instruction Task IDs
  address         String?
  contractValue   Decimal       @default(0) @db.Decimal(14, 2)
  termsJson       Json?
  status          ProjectStatus @default(SITE_SURVEY)
  pcabRef         String?
  startDate       DateTime?
  targetEndDate   DateTime?
  targetMarginPct Decimal?      @db.Decimal(5, 2) // margin bid at contract signing — Finance tab compares current forecast against this
  isNonCorporate  Boolean       @default(false) // a job for another organization or the owner's own property — expenses only, kept out of company operations
  createdAt       DateTime      @default(now())

  paymentTerms      PaymentTerm[]
  payments          Payment[]
  requisitions      Requisition[]
  changeOrders      ChangeOrder[]
  progressEntries   ProgressEntry[]
  dailyReports      DailyConstructionReport[]
  instructions      SiteInstruction[]
  deliveries        Delivery[]
  meetings          Meeting[]
  logbookEntries    LogbookEntry[]
  tripLogs          TripLog[]
  attendance        Attendance[]
  assignments       ProjectAssignment[]
  payrollRuns       PayrollRun[]
  activityLogs      ProjectActivityLog[]
  milestones        Milestone[]
  rfis              Rfi[]
  workRequests      WorkRequest[]
  findings          Finding[]
  closeoutItems     CloseoutItem[]
  documents         ProjectDocument[]
  materialStocks    ProjectMaterialStock[]
  toolAssets        ToolAsset[]               @relation("ToolCurrentProject")
  materialMovesFrom InventoryMovement[]       @relation("MaterialMoveFrom")
  materialMovesTo   InventoryMovement[]       @relation("MaterialMoveTo")
  toolMovesFrom     ToolMovement[]            @relation("ToolMoveFrom")
  toolMovesTo       ToolMovement[]            @relation("ToolMoveTo")
  pettyCash         PettyCashRequest[]
}

model PaymentTerm {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         PaymentTermType
  label        String
  amount       Decimal           @db.Decimal(14, 2)
  dueCondition String?
  status       PaymentTermStatus @default(PENDING)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())

  // Phase 3 — all optional: nothing is assumed when they are blank.
  invoiceNo            String?
  invoicedAt           DateTime? @db.Date // when the bill was issued (an invoice is not cash received)
  certifiedAt          DateTime? @db.Date // when the client certified/approved it, if they do
  dueDate              DateTime? @db.Date // payment due date — lateness is only measured when this is set
  retentionReleaseDate DateTime? @db.Date // for RETENTION terms: when the held amount is due to be released

  payments Payment[]
}

model Payment {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id])
  paymentTermId String?
  paymentTerm   PaymentTerm? @relation(fields: [paymentTermId], references: [id])
  amount        Decimal      @db.Decimal(14, 2)
  dateReceived  DateTime
  method        String?
  reference     String?
  attachments   Json? // proof of payment: check photos, ARs, PO payment receipts
  clientUuid    String?      @unique // generated by the form; makes a double click / retry record once
  recordedById  String
  recordedBy    User         @relation(fields: [recordedById], references: [id])
  createdAt     DateTime     @default(now())
}

// Manually-checked bank balance for the Finance tab's cash-on-hand figure —
// there's no bank integration, so the Owner periodically types in what the
// bank app shows. Append-only: each check is its own row, latest wins.
model CashSnapshot {
  id           String   @id @default(cuid())
  amount       Decimal  @db.Decimal(14, 2)
  note         String?
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  recordedAt   DateTime @default(now())
}

// ---------- Requisition → PO ----------

model Requisition {
  id             String               @id @default(cuid())
  clientUuid     String               @unique // generated on the device; makes offline sync idempotent
  projectId      String? // nullable: non-project requisitions (emergency / office / warehouse supply)
  project        Project?             @relation(fields: [projectId], references: [id])
  category       RequisitionCategory? // set only when projectId is null
  submittedById  String
  submittedBy    User                 @relation("ReqSubmitter", fields: [submittedById], references: [id])
  submittedAt    DateTime // captured on-device at time of action, not sync time
  urgency        Urgency              @default(NORMAL)
  neededBy       DateTime?
  notes          String?
  status         RequisitionStatus    @default(SUBMITTED)
  estimatedCost  Decimal?             @db.Decimal(14, 2)
  approvedById   String?
  approvedBy     User?                @relation("ReqApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  rejectedReason String?
  offlineSynced  Boolean              @default(false)
  createdAt      DateTime             @default(now())

  items         RequisitionItem[]
  purchaseOrder PurchaseOrder?
}

model RequisitionItem {
  id              String      @id @default(cuid())
  requisitionId   String
  requisition     Requisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  name            String
  spec            String?
  qty             Decimal     @db.Decimal(12, 2)
  unit            String
  // Mirrors the currently-selected quote below (kept so every existing
  // consumer — PO creation, PDFs, dashboard rollups — keeps working
  // unchanged); the source of truth for "what are our options" is quotes.
  estUnitCost     Decimal?    @db.Decimal(12, 2)
  remarks         String? // supplier name of the currently-selected quote
  quotes          ItemQuote[] @relation("ItemQuotes")
  selectedQuoteId String?     @unique
  selectedQuote   ItemQuote?  @relation("SelectedQuote", fields: [selectedQuoteId], references: [id], onDelete: SetNull)
}

// A canvassed price from one supplier for one requisition item. Purchasing
// can record several before the Owner picks which to approve — the picked
// one is mirrored onto RequisitionItem.estUnitCost/remarks via selectedQuoteId.
model ItemQuote {
  id                String          @id @default(cuid())
  requisitionItemId String
  requisitionItem   RequisitionItem @relation("ItemQuotes", fields: [requisitionItemId], references: [id], onDelete: Cascade)
  supplier          String
  unitCost          Decimal         @db.Decimal(12, 2)
  notes             String?
  submittedById     String
  submittedBy       User            @relation(fields: [submittedById], references: [id])
  createdAt         DateTime        @default(now())

  selectedFor RequisitionItem? @relation("SelectedQuote")
}

model PurchaseOrder {
  id            String      @id @default(cuid())
  poNumber      String      @unique
  requisitionId String      @unique
  requisition   Requisition @relation(fields: [requisitionId], references: [id])
  supplier      String
  items         Json // [{ name, qty, unit, unitCost }]
  totalCost     Decimal     @db.Decimal(14, 2)
  deliveryDate  DateTime?
  status        POStatus    @default(OPEN)
  createdById   String
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())

  deliveries Delivery[]
}

// ---------- Change orders & progress (portal) ----------

model ChangeOrder {
  id                 String            @id @default(cuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id])
  title              String
  description        String
  costImpact         Decimal           @default(0) @db.Decimal(14, 2)
  timeImpactDays     Int               @default(0)
  photos             Json?
  status             ChangeOrderStatus @default(PENDING_CLIENT)
  clientResponseAt   DateTime?
  clientResponseById String?
  clientResponseBy   User?             @relation("COResponder", fields: [clientResponseById], references: [id])
  createdById        String
  createdBy          User              @relation("COCreator", fields: [createdById], references: [id])
  createdAt          DateTime          @default(now())

  rfis        Rfi[]
  workRequest WorkRequest?

  // Phase 3 — lifecycle and an immutable before/after record of the contract effect.
  reason          String? // why the change is needed / supporting note
  estimatedCost   Decimal?  @db.Decimal(14, 2) // POTENTIAL only; null = not priced yet
  contractBefore  Decimal?  @db.Decimal(14, 2) // contract value just before this approval posted
  contractAfter   Decimal?  @db.Decimal(14, 2) // ...and just after
  incorporatedAt  DateTime?
  withdrawnAt     DateTime?
  withdrawnReason String?
  withdrawnById   String?
}

model ProgressEntry {
  id              String               @id @default(cuid())
  clientUuid      String?              @unique // offline sync idempotency
  projectId       String
  project         Project              @relation(fields: [projectId], references: [id])
  submittedById   String
  submittedBy     User                 @relation(fields: [submittedById], references: [id])
  workItem        String?
  weight          Decimal?             @db.Decimal(6, 2) // this work item's share of the project, for the weighted accomplishment rollup
  color           String? // hex color for this work item's ring/bar on the accomplishment chart
  pctComplete     Decimal              @db.Decimal(5, 2) // this entry's completion % for workItem (not the whole project)
  notes           String?
  photos          Json?
  visibleToClient Boolean              @default(true)
  createdAt       DateTime             @default(now())
  editedById      String?
  editedAt        DateTime?
  // Existing rows default to APPROVED so nothing already visible to clients
  // changes; the progress API sets this explicitly on every new entry.
  reviewStatus    ProgressReviewStatus @default(APPROVED)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
}

// Daily Construction Report (DCR) — a fuller end-of-day site record than a
// ProgressEntry: work performed by trade, deliveries received, manpower and
// equipment on site, site events, issues, safety, and next-day plan. Posted
// on the project page and, when visibleToClient, mirrored into the client
// portal alongside the progress timeline/radial chart.
model DailyConstructionReport {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id])
  reportNo        String // sequential per project, e.g. "DCR-023"
  reportDate      DateTime // the date the work was performed
  weather         String?
  workingHours    String? // e.g. "7:00 AM – 5:00 PM"
  workProgress    String // work performed today, by trade
  deliveries      Json? // [{ material, qty, supplier, condition }]
  manpower        Json? // [{ role, count }]
  equipment       String? // equipment on site, freeform list
  siteEvents      String? // toolbox meetings, inspections, coordination
  issues          String? // issues / observations
  safety          String? // safety notes/incidents
  weatherNotes    String? // narrative on working conditions, beyond the `weather` tag
  plannedNextDay  String? // planned activities for the next working day
  overallProgress String? // overall daily progress summary
  photos          Json?
  submittedById   String
  submittedBy     User      @relation(fields: [submittedById], references: [id])
  visibleToClient Boolean   @default(true)
  createdAt       DateTime  @default(now())
  editedById      String?
  editedAt        DateTime?

  @@unique([projectId, reportNo])
}

// ---------- Phase 2+ models (schema defined now, UI later) ----------

model Delivery {
  id            String        @id @default(cuid())
  clientUuid    String?       @unique // offline sync idempotency
  poId          String
  po            PurchaseOrder @relation(fields: [poId], references: [id])
  projectId     String? // nullable: mirrors the source requisition, which may be project-less
  project       Project?      @relation(fields: [projectId], references: [id])
  checklist     Json // [{ item, orderedQty, receivedQty, ok, remarks }]
  driverName    String? // driver who brought the delivery
  recipientName String? // person on site/warehouse/office who received it
  verifiedById  String
  verifiedAt    DateTime? // device time at moment of verification
  discrepancies String?
  photos        Json?
  gps           String?
  createdAt     DateTime      @default(now())
}

model WarehouseItem {
  id         String   @id @default(cuid())
  name       String
  unit       String
  currentQty Decimal  @default(0) @db.Decimal(12, 2) // company-wide warehouse balance
  createdAt  DateTime @default(now())

  movements     InventoryMovement[]
  projectStocks ProjectMaterialStock[]
}

// Materialized on-site material balance per (project, item) — updated
// atomically alongside every InventoryMovement, mirroring the
// WarehouseItem.currentQty pattern already used company-wide. Lets the
// Inventory tab show "what's on site right now" per project without summing
// the full movement history on every page load.
model ProjectMaterialStock {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id])
  itemId    String
  item      WarehouseItem @relation(fields: [itemId], references: [id])
  qty       Decimal       @default(0) @db.Decimal(12, 2)
  updatedAt DateTime      @updatedAt

  @@unique([projectId, itemId])
}

model InventoryMovement {
  id            String        @id @default(cuid())
  clientUuid    String?       @unique // offline sync idempotency
  itemId        String
  item          WarehouseItem @relation(fields: [itemId], references: [id])
  type          MovementType
  qty           Decimal       @db.Decimal(12, 2)
  fromLoc       String // display label: "Warehouse" | "Supplier" | project name snapshot
  toLoc         String
  fromProjectId String? // set when the source is a project's on-site stock
  fromProject   Project?      @relation("MaterialMoveFrom", fields: [fromProjectId], references: [id])
  toProjectId   String? // set when the destination is a project's on-site stock
  toProject     Project?      @relation("MaterialMoveTo", fields: [toProjectId], references: [id])
  actorId       String
  createdAt     DateTime      @default(now())
}

enum ToolStatus {
  IN_WAREHOUSE
  ON_SITE
  UNDER_REPAIR
  LOST
}

enum ToolMovementType {
  CHECKOUT_TO_SITE
  RETURN_TO_WAREHOUSE
  TRANSFER_SITE_TO_SITE
  MARK_UNDER_REPAIR
  MARK_LOST
  MARK_AVAILABLE // repaired / found — returns to warehouse availability
}

// Individual tool/equipment asset (Spec 6.4 extension, owner's request
// 2026-07-07): tracked as one unit per row — e.g. "Welding Machine #2" — not
// a bulk quantity, so at any time you know exactly which project holds which
// unit and its condition.
model ToolAsset {
  id               String     @id @default(cuid())
  name             String // e.g. "Welding Machine"
  assetTag         String? // e.g. "WM-002", optional serial/tag
  category         String? // e.g. Power Tool, Heavy Equipment, Hand Tool
  condition        String? // latest condition note
  status           ToolStatus @default(IN_WAREHOUSE)
  currentProjectId String? // null = in warehouse
  currentProject   Project?   @relation("ToolCurrentProject", fields: [currentProjectId], references: [id])
  createdAt        DateTime   @default(now())

  movements ToolMovement[]
}

model ToolMovement {
  id            String           @id @default(cuid())
  clientUuid    String?          @unique // offline sync idempotency
  toolId        String
  tool          ToolAsset        @relation(fields: [toolId], references: [id])
  type          ToolMovementType
  fromProjectId String?
  fromProject   Project?         @relation("ToolMoveFrom", fields: [fromProjectId], references: [id])
  toProjectId   String?
  toProject     Project?         @relation("ToolMoveTo", fields: [toProjectId], references: [id])
  condition     String? // condition note at time of movement (e.g. damage report)
  photoUrl      String?
  actorId       String
  createdAt     DateTime         @default(now())
}

model Attendance {
  id          String    @id @default(cuid())
  clientUuid  String?   @unique // offline sync idempotency
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  projectId   String? // null = office
  project     Project?  @relation(fields: [projectId], references: [id])
  timeIn      DateTime
  timeOut     DateTime?
  gpsIn       String?
  gpsOut      String?
  deviceIn    String? // readable label, e.g. "Android · Chrome"
  deviceOut   String?
  deviceIdIn  String? // persistent per-browser id (localStorage) — same id tapping in for different users is a buddy-punching signal
  deviceIdOut String?
  source      String    @default("online") // online | offline_synced
  createdAt   DateTime  @default(now())

  adjustmentRequests TimeAdjustmentRequest[]
}

enum TimeAdjustmentType {
  EARLY_START // credit for time clocked in before the department's scheduled start
  OVERTIME // credit for time clocked out after 5:00 PM
  WEEKEND_WORK // pre-authorization to clock in Sat past 5pm / at all on Sun (Office/Driver only)
}

enum TimeAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

// A worker's request to count time that the standard payroll clamp would
// otherwise exclude (clocked in before the scheduled start, or clocked out
// past 5pm) — e.g. an early delivery or a late concrete pour. Owner/PM decide;
// only an APPROVED request lifts the clamp for that specific shift, in
// src/lib/time-rules.ts's computeEffectiveHours(). Nothing here ever mutates
// the underlying Attendance row — it stays the untouched source of truth.
//
// WEEKEND_WORK is the one type filed BEFORE a shift exists (attendanceId is
// null; date names the Saturday/Sunday instead) — Office/Driver are normally
// locked out of Sunday clock-in and force-closed at 5pm Saturday, so this is
// their pre-authorization to work that day at all. An approved one exempts
// every attendance row that lands on that Manila date from every clamp
// (start, breaks, 5pm cutoff) — see computeEffectiveHours's weekendApproved.
model TimeAdjustmentRequest {
  id            String               @id @default(cuid())
  attendanceId  String? // null for a WEEKEND_WORK pre-authorization
  attendance    Attendance?          @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  date          DateTime? // Manila calendar date this applies to — set only for WEEKEND_WORK
  userId        String // whose shift/day this is (normally == requestedById, unless a supervisor files it for their crew)
  user          User                 @relation("TimeAdjUser", fields: [userId], references: [id])
  type          TimeAdjustmentType
  reason        String
  requestedById String
  requestedBy   User                 @relation("TimeAdjRequester", fields: [requestedById], references: [id])
  status        TimeAdjustmentStatus @default(PENDING)
  decidedById   String?
  decidedBy     User?                @relation("TimeAdjDecider", fields: [decidedById], references: [id])
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime             @default(now())

  @@unique([attendanceId, type])
  @@unique([userId, date, type])
}

// Owner's manual correction for one employee's one day of computed hours —
// e.g. a buddy-punch glitch or a forgotten clock-out produced an obviously
// wrong number. Setting it IS the approval (no separate review step, since
// only the Owner can set one); hours over 8 require approvedOver8 so a typo
// can't silently blow past the standard cap. Once set, this value replaces
// computeEffectiveHours()'s result for that user+day everywhere — the
// attendance summary and payroll both read it, so the two can never diverge.
model DailyHoursOverride {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("HoursOverrideOwner", fields: [userId], references: [id])
  date          DateTime // Manila calendar day this override applies to
  hours         Decimal  @db.Decimal(5, 2)
  approvedOver8 Boolean  @default(false)
  setById       String
  setBy         User     @relation("HoursOverrideSetBy", fields: [setById], references: [id])
  setAt         DateTime @default(now())

  @@unique([userId, date])
}

// Owner-set correction to one employee's TOTAL hours for one pay period (the
// "Hours (pay period)" figure on the attendance page): a signed delta on top
// of the computed total, so later clock-ins keep accumulating normally.
// Payroll adds it to regular hours when generating that period's run.
// projectId is "" for office/driver periods, the project id for a site crew's
// per-project weekly total.
model PeriodHoursAdjustment {
  id          String   @id @default(cuid())
  userId      String
  projectId   String   @default("")
  periodStart DateTime
  deltaHours  Decimal  @db.Decimal(7, 2)
  setById     String
  setAt       DateTime @default(now())

  @@unique([userId, projectId, periodStart])
}

// Employee roster per project: who works on it, since when, at what rate.
// Drives per-project payroll runs (rate here overrides the user's profile).
model ProjectAssignment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  startDate  DateTime // date the employee started on this project
  hourlyRate Decimal  @db.Decimal(12, 2)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([projectId, userId])
}

// Permanent one-line record of notable project events (a daily report posted,
// a progress entry approved or queried...). Daily reports are auto-deleted
// after 7 days; this line — date, author, summary — outlives them so the
// project's activity history isn't lost. refId lets the feed hide a log line
// while its live record still exists.
model ProjectActivityLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // DAILY_REPORT | PROGRESS_APPROVED | PROGRESS_QUERIED ...
  refId     String?
  summary   String
  actorName String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

// A project milestone. Dates are calendar days (no time of day) so variance is
// whole days and can't drift with timezones. The baseline is the approved
// plan: set or revised only by the Owner, every revision stored with a reason
// in MilestoneBaselineRevision. The PM keeps forecast/actual dates current.
model Milestone {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  sortOrder       Int             @default(0)
  baselineStart   DateTime?       @db.Date
  baselineFinish  DateTime?       @db.Date
  forecastStart   DateTime?       @db.Date
  forecastFinish  DateTime?       @db.Date
  actualFinish    DateTime?       @db.Date
  status          MilestoneStatus @default(NOT_STARTED)
  responsibleId   String?
  responsible     User?           @relation("MilestoneResponsible", fields: [responsibleId], references: [id])
  notes           String? // internal — never shown to clients
  visibleToClient Boolean         @default(true)
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  revisions MilestoneBaselineRevision[]
  rfis      Rfi[]

  @@index([projectId, sortOrder])
}

// Immutable history of a milestone's approved baseline (revision 1 = original).
model MilestoneBaselineRevision {
  id             String    @id @default(cuid())
  milestoneId    String
  milestone      Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  revision       Int
  baselineStart  DateTime? @db.Date
  baselineFinish DateTime? @db.Date
  reason         String
  revisedById    String
  revisedByName  String
  createdAt      DateTime  @default(now())

  @@unique([milestoneId, revision])
}

// Request for information. Project-scoped number (RFI-001...). INTERNAL RFIs
// are answered by staff; CLIENT RFIs are answered in the client portal.
model Rfi {
  id                 String           @id @default(cuid())
  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number             Int
  clientUuid         String?          @unique // offline idempotency: raised from site without signal
  subject            String
  question           String
  addressedTo        RfiAddressee     @default(INTERNAL)
  assigneeId         String? // staff member expected to answer an INTERNAL RFI
  assignee           User?            @relation("RfiAssignee", fields: [assigneeId], references: [id])
  answerApprovedById String? // Owner who let an assigned foreman answer this RFI (foremen can't answer without it)
  answerApprovedAt   DateTime?
  status             RfiStatus        @default(OPEN)
  dueDate            DateTime?        @db.Date
  workItem           String? // free-text reference to a progress work item
  dailyReportNo      String? // e.g. DCR-004 — text, so it survives the 7-day report cleanup
  milestoneId        String?
  milestone          Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  siteInstructionId  String?
  siteInstruction    SiteInstruction? @relation(fields: [siteInstructionId], references: [id], onDelete: SetNull)
  changeOrderId      String?
  changeOrder        ChangeOrder?     @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)
  documentId         String? // the drawing/document this question is about
  document           ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  photos             Json?
  costImpact         ImpactStatus     @default(UNKNOWN)
  scheduleImpact     ImpactStatus     @default(UNKNOWN)
  scheduleImpactDays Int?
  impactNote         String?
  raisedById         String
  raisedBy           User             @relation("RfiRaiser", fields: [raisedById], references: [id])
  createdAt          DateTime         @default(now())
  responseText       String?
  responsePhotos     Json?
  respondedById      String?
  respondedByName    String?
  respondedAt        DateTime?
  closedAt           DateTime?

  @@unique([projectId, number])
  @@index([projectId, status])
}

model Finding {
  id                   String          @id @default(cuid())
  projectId            String
  project              Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number               Int // project-scoped: QS-001...
  clientUuid           String?         @unique // offline idempotency
  type                 FindingType
  severity             FindingSeverity
  title                String
  description          String
  location             String?
  workItem             String?
  ownerId              String? // who has to fix it
  owner                User?           @relation("FindingOwner", fields: [ownerId], references: [id])
  dueDate              DateTime?       @db.Date
  status               FindingStatus   @default(OPEN)
  restricted           Boolean         @default(false) // incidents: visible to Owner, PM, raiser and owner only
  photos               Json?
  raisedById           String
  raisedBy             User            @relation("FindingRaiser", fields: [raisedById], references: [id])
  createdAt            DateTime        @default(now())
  // closure: evidence from the fixer, then a separate reviewer closes it
  closureNote          String?
  closurePhotos        Json?
  closureSubmittedById String?
  closureSubmittedAt   DateTime?
  reviewNote           String? // why it was sent back
  closedById           String?
  closedByName         String?
  closedAt             DateTime?

  @@unique([projectId, number])
  @@index([projectId, status])
}

model CloseoutItem {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  category   String?
  sortOrder  Int       @default(0)
  required   Boolean   @default(true)
  done       Boolean   @default(false)
  doneById   String?
  doneByName String?
  doneAt     DateTime?
  note       String?
  createdAt  DateTime  @default(now())

  @@index([projectId, sortOrder])
}

// A controlled project document (drawing, spec, permit...). Only references and metadata are
// stored here: each revision is either a link to a file kept elsewhere or a small upload in the
// private bucket. Revisions are never overwritten — a new one supersedes the previous current.
model ProjectDocument {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  docNo           String? // e.g. drawing number A-101
  category        DocumentCategory @default(OTHER)
  visibleToClient Boolean          @default(false)
  createdById     String
  createdAt       DateTime         @default(now())

  revisions DocumentRevision[]
  rfis      Rfi[]

  @@index([projectId])
}

model DocumentRevision {
  id             String          @id @default(cuid())
  documentId     String
  document       ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  revision       String // "A", "B", "Rev 3"...
  url            String // https link, or /api/files/... for an upload
  isExternal     Boolean         @default(true)
  fileName       String?
  notes          String?
  current        Boolean         @default(true)
  uploadedById   String
  uploadedByName String
  createdAt      DateTime        @default(now())
  supersededAt   DateTime?

  @@unique([documentId, revision])
}

model WorkRequest {
  id               String            @id @default(cuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number           Int // project-scoped: AW-001, AW-002...
  title            String
  description      String
  photos           Json?
  requestedById    String // the client user, or the staff member who recorded the instruction
  requestedBy      User              @relation("WorkRequester", fields: [requestedById], references: [id])
  kind             WorkRequestKind   @default(ADDITION)
  source           WorkRequestSource @default(PORTAL)
  instructedByName String? // who at the client gave the instruction (when staff recorded it)
  instructedOn     DateTime?         @db.Date // the day it was given
  clientUuid       String?           @unique // offline idempotency for instructions recorded on site
  status           WorkRequestStatus @default(REQUESTED)
  createdAt        DateTime          @default(now())
  // Staff assessment — the estimate and note are internal until a change order is sent.
  estimatedCost    Decimal?          @db.Decimal(14, 2)
  estimatedDays    Int?
  internalNote     String?
  declineReason    String? // shown to the client
  reviewedById     String?
  reviewedByName   String?
  reviewedAt       DateTime?
  changeOrderId    String?           @unique
  changeOrder      ChangeOrder?      @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)
  withdrawnAt      DateTime?

  @@unique([projectId, number])
  @@index([projectId, status])
}

model PayrollRun {
  id                    String                 @id @default(cuid())
  // Exactly one of the two: project payroll (site crew per project) or a
  // department run (office staff / drivers, who have no project).
  projectId             String?
  project               Project?               @relation(fields: [projectId], references: [id])
  department            Department?
  periodStart           DateTime
  periodEnd             DateTime
  entries               Json // [{ userId, hours, ot, gross, deductions, net, slipRef }]
  status                PayrollStatus          @default(DRAFT)
  createdAt             DateTime               @default(now())
  approvedAt            DateTime? // when the Owner approved it — printed on payslips as the approval
  approvedByName        String?
  cashAdvanceDeductions CashAdvanceDeduction[]
}

model SiteInstruction {
  id                String               @id @default(cuid())
  taskId            String?              @unique // e.g. OOT-2026-0001, DOT-2026-0001, or {ProjectCode}-2026-0001 — assigned once at creation, never changes
  title             String? // short task title; nullable so pre-existing rows (created before this field) stay valid
  projectId         String? // nullable: not every instruction needs an active project
  project           Project?             @relation(fields: [projectId], references: [id])
  category          InstructionCategory? // set when projectId is blank — office/site/deliveries/etc.
  postedById        String
  postedBy          User                 @relation("InstructionPostedBy", fields: [postedById], references: [id])
  assignedToId      String? // legacy single-assignee column — superseded by assignees below, kept for old rows, no longer written
  assignedTo        User?                @relation("InstructionAssignedTo", fields: [assignedToId], references: [id])
  assignees         User[]               @relation("InstructionAssignees") // empty = broadcast to the whole site team
  text              String // the task's purpose/description
  photoUrl          String?
  status            InstructionStatus    @default(NOT_STARTED)
  priority          InstructionPriority  @default(NORMAL)
  dueDate           DateTime? // target completion date the boss wants
  remarks           String? // assignee's latest progress update
  completedAt       DateTime? // actual completion date
  supervisorRemarks String?
  approval          InstructionApproval  @default(PENDING)
  createdAt         DateTime             @default(now())

  seenBy InstructionSeen[]
  rfis   Rfi[]
}

// One row per (instruction, assignee) the moment that assignee first opens/
// views it — lets the poster see who has acknowledged their specific task.
// Only meaningful for specific assignees; a broadcast has no fixed roster.
model InstructionSeen {
  id            String          @id @default(cuid())
  instructionId String
  instruction   SiteInstruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  seenAt        DateTime        @default(now())

  @@unique([instructionId, userId])
}

model Meeting {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  date        DateTime
  attendees   Json
  notes       String?
  actionItems Json?
  createdAt   DateTime @default(now())
}

model LogbookEntry {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  date           DateTime
  sourcePhotoUrl String?
  ocrJson        Json?
  confirmedById  String?
  createdAt      DateTime @default(now())
}

model Permit {
  id          String       @id @default(cuid())
  name        String
  issuingBody String?
  issueDate   DateTime?
  expiryDate  DateTime
  documentUrl String?
  status      PermitStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
}

model TripLog {
  id          String    @id @default(cuid())
  driverId    String
  driver      User      @relation(fields: [driverId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  origin      String
  destination String
  items       Json?
  departTime  DateTime
  arriveTime  DateTime?
  createdAt   DateTime  @default(now())
}

// ---------- Audit (append-only) ----------

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorName  String
  action     String
  diff       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ---------- Sign-in protection ----------

enum AuthAttemptKind {
  LOGIN
  RESET // forgot-password requests
}

enum AuthAttemptResult {
  PENDING // recorded before the password is checked, so a burst of parallel guesses is still counted
  FAIL
  BLOCKED // refused by the lockout; kept for the record but never counted toward it
}

// Successful sign-ins leave no row. Rows older than a day are deleted as new attempts arrive.
model AuthAttempt {
  id        String            @id @default(cuid())
  kind      AuthAttemptKind
  result    AuthAttemptResult
  email     String // lower-cased text as typed — also recorded for emails that don't exist, so lockout looks the same either way
  ip        String
  createdAt DateTime          @default(now())

  @@index([email, ip, createdAt])
  @@index([ip, createdAt])
  @@index([email, createdAt])
}

// How many payslips a person had already received in a year before this system started numbering them — so their
// next payslip continues their own count ("Reference No. 2026-020" = their 20th payslip of 2026).
model PayslipBaseline {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  year   Int
  count  Int

  @@unique([userId, year])
}

// ---------- Cash Expense: petty cash and cash advances (2026-10-19) ----------

// PENDING (filed) -> APPROVED (Owner or an assigned approver) -> RELEASED (cash handed out by an assigned releaser;
// the requester then confirms receipt in the app) -> FOR_LIQUIDATION (the
// requester turned in receipts and what was really spent) -> LIQUIDATED (verified; the spent amount is posted as a
// cost of its project, or as company overhead when there's no project). REJECTED / CANCELLED end it early.
enum PettyCashStatus {
  PENDING
  APPROVED
  RELEASED
  FOR_LIQUIDATION
  LIQUIDATED
  REJECTED
  CANCELLED
}

enum PettyCashCategory {
  SITE_SUPPLIES
  FUEL
  MEALS
  TRANSPORTATION
  TOOLS_EQUIPMENT
  REPAIRS_MAINTENANCE
  OFFICE_SUPPLIES
  PERMITS_FEES
  UTILITIES
  OTHER
}

model PettyCashRequest {
  id                     String            @id @default(cuid())
  number                 Int               @unique // PC-0001…
  projectId              String? // null = not for a project (company overhead)
  project                Project?          @relation(fields: [projectId], references: [id])
  category               PettyCashCategory
  amount                 Decimal           @db.Decimal(12, 2) // cash requested / released
  purpose                String
  receipts               Json? // optional receipt/quote photos attached when filing
  requestedById          String
  requestedBy            User              @relation("PettyCashRequester", fields: [requestedById], references: [id])
  createdById            String // who typed it in (can differ from the requester)
  status                 PettyCashStatus   @default(PENDING)
  createdAt              DateTime          @default(now())
  approvedByName         String?
  approvedAt             DateTime?
  rejectedReason         String?
  releasedByName         String?
  releasedAt             DateTime?
  receivedAt             DateTime? // the requester confirmed in the app that they got the released cash
  // Liquidation (Petty Cash Report)
  spentAmount            Decimal?          @db.Decimal(12, 2) // what was really spent, from the receipts
  liquidationItems       Json? // [{ description, amount }]
  liquidationReceipts    Json? // receipt photos
  liquidationNote        String?
  liquidationSubmittedAt DateTime?
  liquidatedByName       String?
  liquidatedAt           DateTime? // the day it was verified — the expense's posting date

  @@index([status])
  @@index([projectId, status])
}

// Money put into (or taken out of) the petty cash fund itself: replenishments and corrections.
model PettyCashFundEntry {
  id             String   @id @default(cuid())
  amount         Decimal  @db.Decimal(12, 2) // + into the fund, - out of it
  note           String?
  recordedById   String
  recordedByName String
  createdAt      DateTime @default(now())
}

// PENDING (filed) -> ACTIVE (approved and handed out; deducted from payroll every cut-off) -> PAID (fully deducted).
enum CashAdvanceStatus {
  PENDING
  ACTIVE
  PAID
  REJECTED
  CANCELLED
}

model CashAdvance {
  id                 String                 @id @default(cuid())
  number             Int                    @unique // CA-0001…
  userId             String
  user               User                   @relation("CashAdvanceBorrower", fields: [userId], references: [id])
  amount             Decimal                @db.Decimal(12, 2)
  deductionPerCutoff Decimal                @db.Decimal(12, 2) // taken from each payroll cut-off until paid
  reason             String
  status             CashAdvanceStatus      @default(PENDING)
  createdById        String
  createdByName      String
  createdAt          DateTime               @default(now())
  approvedByName     String?
  approvedAt         DateTime? // approved and released
  rejectedReason     String?
  deductions         CashAdvanceDeduction[]

  @@index([userId, status])
}

// One repayment: a payroll deduction (posted when the run is approved, removed if the approval is cancelled), or a
// cash payment the Owner recorded by hand (payrollRunId null).
model CashAdvanceDeduction {
  id             String      @id @default(cuid())
  advanceId      String
  advance        CashAdvance @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  payrollRunId   String?
  payrollRun     PayrollRun? @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  amount         Decimal     @db.Decimal(12, 2)
  note           String?
  recordedByName String
  createdAt      DateTime    @default(now())

  @@unique([advanceId, payrollRunId])
  @@index([payrollRunId])
}

// ---------- Phone notifications ----------

// The key pair that lets the server prove to the phone makers' push services that a notification really comes from this
// app. Generated once, on first use. Single row.
model PushConfig {
  id         String   @id // always "singleton"
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
}

// One row per phone/browser that has turned notifications on. A person can have several.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}

// Everything someone was told about, so nothing is lost if a phone alert is missed. The bell in the app reads from here.
model AppNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  title     String
  body      String
  url       String
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// A person's own settings: categories they have muted and optional quiet hours (Manila time) with no phone alerts.
model NotificationPref {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  muted      String[] @default([])
  quietStart Int? // hour 0-23
  quietEnd   Int? // hour 0-23; may be earlier than start (e.g. 21 to 6)
}

/// Per-person phone/app preferences: which tabs sit on the bottom bar of the phone view (empty = the default for their role)
/// and the language of the app (en or fil).
model UserPref {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobileTabs   String[] @default([])
  /// what the floating + button offers, in order (empty = the default for their role)
  quickActions String[] @default([])
  language     String   @default("en")
  updatedAt    DateTime @updatedAt
}

/// A fingerprint / Face ID sign-in (WebAuthn passkey) a person set up on a phone or computer. Only the public half is kept.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    String // base64url COSE public key
  counter      Int       @default(0)
  transports   String[]  @default([])
  label        String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
}
